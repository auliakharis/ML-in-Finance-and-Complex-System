{
  "meta": {
    "name": "10-K Financial Statement Template",
    "version": "1.0.0",
    "description": "Structured template for generating synthetic financial QA datasets from 10-K filings",
    "source_standard": "US GAAP / XBRL Taxonomy",
    "covers": ["balance_sheet", "income_statement", "cash_flow_statement"]
  },

  "financial_statements": {

    "balance_sheet": {
      "description": "Consolidated Balance Sheet (Statement of Financial Position)",
      "periods": ["current_year", "prior_year"],
      "sections": {

        "current_assets": {
          "label": "Current Assets",
          "xbrl_parent": "us-gaap:AssetsCurrent",
          "aggregation": "sum",
          "line_items": {
            "cash_and_equivalents": {
              "label": "Cash and cash equivalents",
              "xbrl_tag": "us-gaap:CashAndCashEquivalentsAtCarryingValue",
              "type": "monetary",
              "typical_range": [1000, 50000],
              "unit": "millions"
            },
            "short_term_investments": {
              "label": "Short-term investments",
              "xbrl_tag": "us-gaap:ShortTermInvestments",
              "type": "monetary",
              "typical_range": [0, 30000],
              "unit": "millions"
            },
            "accounts_receivable_net": {
              "label": "Accounts receivable, net",
              "xbrl_tag": "us-gaap:AccountsReceivableNetCurrent",
              "type": "monetary",
              "typical_range": [5000, 60000],
              "unit": "millions"
            },
            "inventories": {
              "label": "Inventories",
              "xbrl_tag": "us-gaap:InventoryNet",
              "type": "monetary",
              "typical_range": [0, 40000],
              "unit": "millions"
            },
            "prepaid_expenses": {
              "label": "Prepaid expenses and other current assets",
              "xbrl_tag": "us-gaap:PrepaidExpenseAndOtherAssetsCurrent",
              "type": "monetary",
              "typical_range": [500, 15000],
              "unit": "millions"
            }
          },
          "total": {
            "var": "total_current_assets",
            "label": "Total current assets",
            "xbrl_tag": "us-gaap:AssetsCurrent",
            "formula": "sum(cash_and_equivalents, short_term_investments, accounts_receivable_net, inventories, prepaid_expenses)"
          }
        },

        "non_current_assets": {
          "label": "Non-Current Assets",
          "xbrl_parent": "us-gaap:AssetsNoncurrent",
          "aggregation": "sum",
          "line_items": {
            "property_plant_equipment_net": {
              "label": "Property, plant and equipment, net",
              "xbrl_tag": "us-gaap:PropertyPlantAndEquipmentNet",
              "type": "monetary",
              "typical_range": [5000, 150000],
              "unit": "millions"
            },
            "goodwill": {
              "label": "Goodwill",
              "xbrl_tag": "us-gaap:Goodwill",
              "type": "monetary",
              "typical_range": [0, 80000],
              "unit": "millions"
            },
            "intangible_assets_net": {
              "label": "Intangible assets, net",
              "xbrl_tag": "us-gaap:IntangibleAssetsNetExcludingGoodwill",
              "type": "monetary",
              "typical_range": [0, 30000],
              "unit": "millions"
            },
            "long_term_investments": {
              "label": "Long-term investments",
              "xbrl_tag": "us-gaap:LongTermInvestments",
              "type": "monetary",
              "typical_range": [0, 50000],
              "unit": "millions"
            },
            "deferred_tax_assets": {
              "label": "Deferred income tax assets",
              "xbrl_tag": "us-gaap:DeferredIncomeTaxAssetsNet",
              "type": "monetary",
              "typical_range": [0, 15000],
              "unit": "millions"
            },
            "other_non_current_assets": {
              "label": "Other non-current assets",
              "xbrl_tag": "us-gaap:OtherAssetsNoncurrent",
              "type": "monetary",
              "typical_range": [0, 20000],
              "unit": "millions"
            }
          },
          "total": {
            "var": "total_non_current_assets",
            "label": "Total non-current assets",
            "formula": "sum(property_plant_equipment_net, goodwill, intangible_assets_net, long_term_investments, deferred_tax_assets, other_non_current_assets)"
          }
        },

        "total_assets": {
          "var": "total_assets",
          "label": "Total assets",
          "xbrl_tag": "us-gaap:Assets",
          "formula": "sum(total_current_assets, total_non_current_assets)"
        },

        "current_liabilities": {
          "label": "Current Liabilities",
          "xbrl_parent": "us-gaap:LiabilitiesCurrent",
          "aggregation": "sum",
          "line_items": {
            "accounts_payable": {
              "label": "Accounts payable",
              "xbrl_tag": "us-gaap:AccountsPayableCurrent",
              "type": "monetary",
              "typical_range": [3000, 70000],
              "unit": "millions"
            },
            "accrued_expenses": {
              "label": "Accrued expenses and other current liabilities",
              "xbrl_tag": "us-gaap:AccruedLiabilitiesCurrent",
              "type": "monetary",
              "typical_range": [2000, 50000],
              "unit": "millions"
            },
            "short_term_debt": {
              "label": "Short-term debt and current portion of long-term debt",
              "xbrl_tag": "us-gaap:ShortTermBorrowings",
              "type": "monetary",
              "typical_range": [0, 20000],
              "unit": "millions"
            },
            "deferred_revenue_current": {
              "label": "Deferred revenue, current",
              "xbrl_tag": "us-gaap:ContractWithCustomerLiabilityCurrent",
              "type": "monetary",
              "typical_range": [0, 15000],
              "unit": "millions"
            },
            "income_taxes_payable": {
              "label": "Income taxes payable",
              "xbrl_tag": "us-gaap:AccruedIncomeTaxesCurrent",
              "type": "monetary",
              "typical_range": [0, 8000],
              "unit": "millions"
            }
          },
          "total": {
            "var": "total_current_liabilities",
            "label": "Total current liabilities",
            "xbrl_tag": "us-gaap:LiabilitiesCurrent",
            "formula": "sum(accounts_payable, accrued_expenses, short_term_debt, deferred_revenue_current, income_taxes_payable)"
          }
        },

        "non_current_liabilities": {
          "label": "Non-Current Liabilities",
          "xbrl_parent": "us-gaap:LiabilitiesNoncurrent",
          "aggregation": "sum",
          "line_items": {
            "long_term_debt": {
              "label": "Long-term debt",
              "xbrl_tag": "us-gaap:LongTermDebtNoncurrent",
              "type": "monetary",
              "typical_range": [0, 120000],
              "unit": "millions"
            },
            "deferred_revenue_non_current": {
              "label": "Deferred revenue, non-current",
              "xbrl_tag": "us-gaap:ContractWithCustomerLiabilityNoncurrent",
              "type": "monetary",
              "typical_range": [0, 10000],
              "unit": "millions"
            },
            "deferred_tax_liabilities": {
              "label": "Deferred income tax liabilities",
              "xbrl_tag": "us-gaap:DeferredIncomeTaxLiabilitiesNet",
              "type": "monetary",
              "typical_range": [0, 15000],
              "unit": "millions"
            },
            "pension_obligations": {
              "label": "Pension and post-retirement benefit obligations",
              "xbrl_tag": "us-gaap:PensionAndOtherPostretirementDefinedBenefitPlansLiabilitiesNoncurrent",
              "type": "monetary",
              "typical_range": [0, 25000],
              "unit": "millions"
            },
            "other_non_current_liabilities": {
              "label": "Other non-current liabilities",
              "xbrl_tag": "us-gaap:OtherLiabilitiesNoncurrent",
              "type": "monetary",
              "typical_range": [0, 20000],
              "unit": "millions"
            }
          },
          "total": {
            "var": "total_non_current_liabilities",
            "label": "Total non-current liabilities",
            "formula": "sum(long_term_debt, deferred_revenue_non_current, deferred_tax_liabilities, pension_obligations, other_non_current_liabilities)"
          }
        },

        "total_liabilities": {
          "var": "total_liabilities",
          "label": "Total liabilities",
          "xbrl_tag": "us-gaap:Liabilities",
          "formula": "sum(total_current_liabilities, total_non_current_liabilities)"
        },

        "stockholders_equity": {
          "label": "Stockholders' Equity",
          "xbrl_parent": "us-gaap:StockholdersEquity",
          "aggregation": "sum",
          "line_items": {
            "common_stock": {
              "label": "Common stock",
              "xbrl_tag": "us-gaap:CommonStockValue",
              "type": "monetary",
              "typical_range": [1, 100],
              "unit": "millions"
            },
            "additional_paid_in_capital": {
              "label": "Additional paid-in capital",
              "xbrl_tag": "us-gaap:AdditionalPaidInCapital",
              "type": "monetary",
              "typical_range": [5000, 80000],
              "unit": "millions"
            },
            "retained_earnings": {
              "label": "Retained earnings",
              "xbrl_tag": "us-gaap:RetainedEarningsAccumulatedDeficit",
              "type": "monetary",
              "typical_range": [-50000, 200000],
              "unit": "millions",
              "note": "Can be negative (accumulated deficit)"
            },
            "accumulated_other_comprehensive_income": {
              "label": "Accumulated other comprehensive income (loss)",
              "xbrl_tag": "us-gaap:AccumulatedOtherComprehensiveIncomeLossNetOfTax",
              "type": "monetary",
              "typical_range": [-20000, 5000],
              "unit": "millions",
              "note": "Frequently negative"
            },
            "treasury_stock": {
              "label": "Treasury stock, at cost",
              "xbrl_tag": "us-gaap:TreasuryStockValue",
              "type": "monetary",
              "typical_range": [-150000, 0],
              "unit": "millions",
              "note": "Contra-equity; always negative or zero"
            }
          },
          "total": {
            "var": "total_stockholders_equity",
            "label": "Total stockholders' equity",
            "xbrl_tag": "us-gaap:StockholdersEquity",
            "formula": "sum(common_stock, additional_paid_in_capital, retained_earnings, accumulated_other_comprehensive_income, treasury_stock)"
          }
        },

        "total_liabilities_and_equity": {
          "var": "total_liabilities_and_equity",
          "label": "Total liabilities and stockholders' equity",
          "xbrl_tag": "us-gaap:LiabilitiesAndStockholdersEquity",
          "formula": "sum(total_liabilities, total_stockholders_equity)",
          "constraint": "must_equal(total_assets)"
        }
      },

      "accounting_identity": "total_assets == total_liabilities + total_stockholders_equity"
    },

    "income_statement": {
      "description": "Consolidated Statement of Operations",
      "periods": ["current_year", "prior_year", "two_years_prior"],
      "sections": {
        "revenue": {
          "label": "Revenue",
          "line_items": {
            "total_revenue": {
              "label": "Total revenue / Net sales",
              "xbrl_tag": "us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax",
              "type": "monetary",
              "typical_range": [50000, 600000],
              "unit": "millions"
            }
          }
        },
        "cost_of_revenue": {
          "label": "Cost of Revenue",
          "line_items": {
            "cost_of_goods_sold": {
              "label": "Cost of goods sold / Cost of revenue",
              "xbrl_tag": "us-gaap:CostOfGoodsAndServicesSold",
              "type": "monetary",
              "typical_range": [20000, 400000],
              "unit": "millions"
            }
          }
        },
        "gross_profit": {
          "var": "gross_profit",
          "label": "Gross profit",
          "xbrl_tag": "us-gaap:GrossProfit",
          "formula": "diff(total_revenue, cost_of_goods_sold)"
        },
        "operating_expenses": {
          "label": "Operating Expenses",
          "line_items": {
            "research_and_development": {
              "label": "Research and development",
              "xbrl_tag": "us-gaap:ResearchAndDevelopmentExpense",
              "type": "monetary",
              "typical_range": [0, 50000],
              "unit": "millions"
            },
            "selling_general_admin": {
              "label": "Selling, general and administrative",
              "xbrl_tag": "us-gaap:SellingGeneralAndAdministrativeExpense",
              "type": "monetary",
              "typical_range": [5000, 60000],
              "unit": "millions"
            },
            "depreciation_amortization": {
              "label": "Depreciation and amortization",
              "xbrl_tag": "us-gaap:DepreciationAndAmortization",
              "type": "monetary",
              "typical_range": [1000, 30000],
              "unit": "millions"
            },
            "other_operating_expenses": {
              "label": "Other operating expenses (income)",
              "xbrl_tag": "us-gaap:OtherOperatingIncomeExpenseNet",
              "type": "monetary",
              "typical_range": [-5000, 10000],
              "unit": "millions"
            }
          },
          "total": {
            "var": "total_operating_expenses",
            "label": "Total operating expenses",
            "formula": "sum(research_and_development, selling_general_admin, depreciation_amortization, other_operating_expenses)"
          }
        },
        "operating_income": {
          "var": "operating_income",
          "label": "Operating income (EBIT)",
          "xbrl_tag": "us-gaap:OperatingIncomeLoss",
          "formula": "diff(gross_profit, total_operating_expenses)"
        },
        "non_operating": {
          "label": "Non-Operating Items",
          "line_items": {
            "interest_expense": {
              "label": "Interest expense",
              "xbrl_tag": "us-gaap:InterestExpense",
              "type": "monetary",
              "typical_range": [0, 10000],
              "unit": "millions"
            },
            "interest_income": {
              "label": "Interest and dividend income",
              "xbrl_tag": "us-gaap:InvestmentIncomeInterestAndDividend",
              "type": "monetary",
              "typical_range": [0, 5000],
              "unit": "millions"
            },
            "other_income_expense": {
              "label": "Other income (expense), net",
              "xbrl_tag": "us-gaap:OtherNonoperatingIncomeExpense",
              "type": "monetary",
              "typical_range": [-3000, 3000],
              "unit": "millions"
            }
          }
        },
        "income_before_tax": {
          "var": "income_before_tax",
          "label": "Income before income taxes",
          "xbrl_tag": "us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest",
          "formula": "operating_income - interest_expense + interest_income + other_income_expense"
        },
        "income_tax_expense": {
          "var": "income_tax_expense",
          "label": "Income tax expense",
          "xbrl_tag": "us-gaap:IncomeTaxExpenseBenefit",
          "type": "monetary",
          "typical_range": [1000, 30000],
          "unit": "millions"
        },
        "net_income": {
          "var": "net_income",
          "label": "Net income",
          "xbrl_tag": "us-gaap:NetIncomeLoss",
          "formula": "diff(income_before_tax, income_tax_expense)"
        },
        "per_share": {
          "label": "Earnings Per Share",
          "line_items": {
            "eps_basic": {
              "label": "Basic earnings per share",
              "xbrl_tag": "us-gaap:EarningsPerShareBasic",
              "type": "per_share",
              "typical_range": [0.5, 30.0]
            },
            "eps_diluted": {
              "label": "Diluted earnings per share",
              "xbrl_tag": "us-gaap:EarningsPerShareDiluted",
              "type": "per_share",
              "typical_range": [0.5, 29.0]
            },
            "shares_basic": {
              "label": "Weighted average shares outstanding, basic",
              "xbrl_tag": "us-gaap:WeightedAverageNumberOfSharesOutstandingBasic",
              "type": "shares",
              "typical_range": [500, 15000],
              "unit": "millions"
            },
            "shares_diluted": {
              "label": "Weighted average shares outstanding, diluted",
              "xbrl_tag": "us-gaap:WeightedAverageNumberOfDilutedSharesOutstanding",
              "type": "shares",
              "typical_range": [500, 16000],
              "unit": "millions"
            }
          }
        }
      }
    },

    "cash_flow_statement": {
      "description": "Consolidated Statement of Cash Flows",
      "periods": ["current_year", "prior_year", "two_years_prior"],
      "sections": {
        "operating_activities": {
          "label": "Cash Flows from Operating Activities",
          "line_items": {
            "net_income_cf": {
              "label": "Net income",
              "source": "income_statement.net_income"
            },
            "depreciation_amortization_cf": {
              "label": "Depreciation and amortization",
              "xbrl_tag": "us-gaap:DepreciationDepletionAndAmortization",
              "type": "monetary"
            },
            "stock_based_compensation": {
              "label": "Stock-based compensation expense",
              "xbrl_tag": "us-gaap:ShareBasedCompensation",
              "type": "monetary",
              "typical_range": [500, 25000],
              "unit": "millions"
            },
            "changes_in_working_capital": {
              "label": "Changes in operating assets and liabilities",
              "xbrl_tag": "us-gaap:IncreaseDecreaseInOperatingCapital",
              "type": "monetary",
              "typical_range": [-20000, 20000],
              "unit": "millions"
            },
            "other_operating_adjustments": {
              "label": "Other operating adjustments",
              "type": "monetary",
              "typical_range": [-5000, 5000],
              "unit": "millions"
            }
          },
          "total": {
            "var": "cash_from_operations",
            "label": "Net cash provided by operating activities",
            "xbrl_tag": "us-gaap:NetCashProvidedByUsedInOperatingActivities"
          }
        },
        "investing_activities": {
          "label": "Cash Flows from Investing Activities",
          "line_items": {
            "capital_expenditures": {
              "label": "Purchases of property, plant and equipment",
              "xbrl_tag": "us-gaap:PaymentsToAcquirePropertyPlantAndEquipment",
              "type": "monetary",
              "typical_range": [1000, 50000],
              "unit": "millions",
              "sign": "negative"
            },
            "acquisitions": {
              "label": "Acquisitions, net of cash acquired",
              "xbrl_tag": "us-gaap:PaymentsToAcquireBusinessesNetOfCashAcquired",
              "type": "monetary",
              "typical_range": [0, 30000],
              "unit": "millions",
              "sign": "negative"
            },
            "purchases_of_investments": {
              "label": "Purchases of investments",
              "xbrl_tag": "us-gaap:PaymentsToAcquireInvestments",
              "type": "monetary",
              "typical_range": [0, 50000],
              "unit": "millions",
              "sign": "negative"
            },
            "proceeds_from_investments": {
              "label": "Proceeds from maturities/sales of investments",
              "xbrl_tag": "us-gaap:ProceedsFromSaleAndMaturityOfMarketableSecurities",
              "type": "monetary",
              "typical_range": [0, 50000],
              "unit": "millions"
            }
          },
          "total": {
            "var": "cash_from_investing",
            "label": "Net cash used in investing activities",
            "xbrl_tag": "us-gaap:NetCashProvidedByUsedInInvestingActivities"
          }
        },
        "financing_activities": {
          "label": "Cash Flows from Financing Activities",
          "line_items": {
            "debt_issued": {
              "label": "Proceeds from issuance of debt",
              "xbrl_tag": "us-gaap:ProceedsFromIssuanceOfLongTermDebt",
              "type": "monetary",
              "typical_range": [0, 30000],
              "unit": "millions"
            },
            "debt_repaid": {
              "label": "Repayments of debt",
              "xbrl_tag": "us-gaap:RepaymentsOfLongTermDebt",
              "type": "monetary",
              "typical_range": [0, 30000],
              "unit": "millions",
              "sign": "negative"
            },
            "share_repurchases": {
              "label": "Repurchases of common stock",
              "xbrl_tag": "us-gaap:PaymentsForRepurchaseOfCommonStock",
              "type": "monetary",
              "typical_range": [0, 90000],
              "unit": "millions",
              "sign": "negative"
            },
            "dividends_paid": {
              "label": "Dividends paid",
              "xbrl_tag": "us-gaap:PaymentsOfDividends",
              "type": "monetary",
              "typical_range": [0, 20000],
              "unit": "millions",
              "sign": "negative"
            }
          },
          "total": {
            "var": "cash_from_financing",
            "label": "Net cash used in financing activities",
            "xbrl_tag": "us-gaap:NetCashProvidedByUsedInFinancingActivities"
          }
        },
        "net_change_in_cash": {
          "var": "net_change_in_cash",
          "label": "Net increase (decrease) in cash and cash equivalents",
          "formula": "sum(cash_from_operations, cash_from_investing, cash_from_financing)"
        }
      }
    }
  },

  "operators": {
    "description": "Allowed operations for composing formal queries",
    "operations": {
      "get_value": {
        "signature": "get_value(variable, period)",
        "description": "Retrieve a single value from the financial statements",
        "args": ["variable_name", "period"],
        "returns": "number",
        "example": "get_value(total_assets, 2024)"
      },
      "diff": {
        "signature": "diff(a, b)",
        "description": "Compute the absolute difference: a - b",
        "args": ["number", "number"],
        "returns": "number",
        "example": "diff(get_value(total_assets, 2024), get_value(total_assets, 2023))"
      },
      "sum": {
        "signature": "sum(a, b, ...)",
        "description": "Sum of two or more values",
        "args": ["number", "number", "..."],
        "returns": "number",
        "example": "sum(get_value(cash_and_equivalents, 2024), get_value(short_term_investments, 2024))"
      },
      "ratio": {
        "signature": "ratio(numerator, denominator)",
        "description": "Divide numerator by denominator",
        "args": ["number", "number"],
        "returns": "number",
        "example": "ratio(get_value(net_income, 2024), get_value(total_revenue, 2024))"
      },
      "pct_change": {
        "signature": "pct_change(variable, period_old, period_new)",
        "description": "Compute percentage change: (new - old) / old * 100",
        "args": ["variable_name", "period", "period"],
        "returns": "percentage",
        "example": "pct_change(total_revenue, 2023, 2024)"
      },
      "multiply": {
        "signature": "multiply(a, b)",
        "description": "Multiply two values",
        "args": ["number", "number"],
        "returns": "number",
        "example": "multiply(get_value(eps_diluted, 2024), get_value(shares_diluted, 2024))"
      },
      "avg": {
        "signature": "avg(a, b, ...)",
        "description": "Average of two or more values",
        "args": ["number", "number", "..."],
        "returns": "number",
        "example": "avg(get_value(total_assets, 2024), get_value(total_assets, 2023))"
      },
      "proportion": {
        "signature": "proportion(part, whole)",
        "description": "Compute what percentage part is of whole: part / whole * 100",
        "args": ["number", "number"],
        "returns": "percentage",
        "example": "proportion(get_value(current_assets, 2024), get_value(total_assets, 2024))"
      },
      "compare_gt": {
        "signature": "compare_gt(a, b)",
        "description": "Returns true if a > b",
        "args": ["number", "number"],
        "returns": "boolean",
        "example": "compare_gt(get_value(total_revenue, 2024), get_value(total_revenue, 2023))"
      }
    }
  },

  "concept_dictionary": {
    "description": "Maps formula patterns to named financial concepts with NL templates",
    "concepts": {

      "current_ratio": {
        "category": "liquidity",
        "formula": "ratio(total_current_assets, total_current_liabilities)",
        "interpretation": "Measures short-term debt-paying ability",
        "nl_templates": [
