  "operator_nl_templates": {
    "description": "Generic NL templates for operators (Layer C of the dictionary)",
    "templates": {
      "get_value": [
        "What was the {variable_label} in {period}?",
        "How much was {variable_label} as of {period}?",
        "What did the company report for {variable_label} in {period}?"
      ],
      "diff": {
        "same_variable_different_periods": [
          "What was the change in {variable_label} from {period1} to {period2}?",
          "By how much did {variable_label} increase or decrease between {period1} and {period2}?",
          "What was the absolute change in {variable_label} year over year?"
        ],
        "different_variables_same_period": [
          "What was the difference between {var1_label} and {var2_label} in {period}?",
          "How much more was {var1_label} than {var2_label} in {period}?"
        ]
      },
      "ratio": {
        "generic": [
          "What was {numerator_label} as a proportion of {denominator_label} in {period}?",
          "What was the ratio of {numerator_label} to {denominator_label}?",
          "For every dollar of {denominator_label}, how much {numerator_label} was there?"
        ]
      },
      "pct_change": [
        "What was the percentage change in {variable_label} from {period1} to {period2}?",
        "By what percentage did {variable_label} grow or decline between {period1} and {period2}?",
        "What was the year-over-year growth rate of {variable_label}?"
      ],
      "sum": [
        "What was the total of {var1_label} and {var2_label} in {period}?",
        "What was the combined amount of {var1_label} and {var2_label}?"
      ],
      "proportion": [
        "What percentage of {whole_label} was {part_label} in {period}?",
        "What share of {whole_label} did {part_label} represent?",
        "How much of {whole_label} was accounted for by {part_label}?"
      ]
    }
  },

