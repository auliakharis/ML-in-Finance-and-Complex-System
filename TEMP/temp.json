  "generation_config": {
    "description": "Configuration for the question generation engine",
    "difficulty_levels": {
      "level_1_lookup": {
        "description": "Simple value retrieval",
        "operators": ["get_value"],
        "max_steps": 1,
        "example": "get_value(total_assets, 2024)"
      },
      "level_2_single_op": {
        "description": "One arithmetic operation on retrieved values",
        "operators": ["diff", "ratio", "pct_change", "sum"],
        "max_steps": 2,
        "example": "diff(get_value(total_assets, 2024), get_value(total_assets, 2023))"
      },
      "level_3_named_concept": {
        "description": "Known financial ratio or metric",
        "operators": ["ratio", "diff", "avg"],
        "max_steps": 3,
        "uses_concept_dictionary": true,
        "example": "ratio(get_value(net_income, 2024), avg(get_value(total_assets, 2024), get_value(total_assets, 2023)))"
      },
      "level_4_multi_step": {
        "description": "Multi-step reasoning combining 2+ operations",
        "operators": ["all"],
        "max_steps": 5,
        "example": "pct_change applied to ratio(net_income, total_equity) across years"
      },
      "level_5_comparative": {
        "description": "Comparison or trend questions across periods",
        "operators": ["all", "compare_gt"],
        "max_steps": 6,
        "example": "Did ROE improve from 2023 to 2024? By how much?"
      }
    }
  }
