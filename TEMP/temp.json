    "long_term_debt": ["long-term debt", "long-term borrowings", "non-current debt"],
    "cash_and_equivalents": ["cash and cash equivalents", "cash on hand", "liquid assets", "cash position"],
    "retained_earnings": ["retained earnings", "accumulated profits", "reinvested earnings"],
